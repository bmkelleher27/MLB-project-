# Port to listen on. Render and most PaaS hosts inject this themselves.
PORT=4000

# Comma-separated browser origins allowed to call this API.
# Unset means "any origin", which is the right default for a public read-only
# API and for local development.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Requests allowed per IP per minute across /api/*. Defaults to 120.
# RATE_LIMIT_PER_MIN=120
