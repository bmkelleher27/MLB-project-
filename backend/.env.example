# Port to listen on. Render and most PaaS hosts inject this themselves.
PORT=4000

# Comma-separated browser origins allowed to call this API.
# Unset means "any origin", which is the right default for a public read-only
# API and for local development.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Requests allowed per IP per minute across /api/*. Defaults to 120.
# RATE_LIMIT_PER_MIN=120

# YouTube Data API v3 key. Optional: when set, each finished game's scorecard
# shows its official video from MLB's channels (a full game when MLB has posted
# one, otherwise MLB's full-game highlights). Without it the scorecard links to
# a search of MLB's YouTube channel instead. Each new game lookup costs about
# 200 of the free 10,000 daily quota units; results are cached.
# YOUTUBE_API_KEY=
