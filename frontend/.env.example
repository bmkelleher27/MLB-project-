# Base URL of the backend API. Read at BUILD time by Vite, so the frontend must
# be rebuilt after this changes.
#
# Local development can leave this unset — it defaults to http://localhost:4000.
# Production builds MUST set it, or every API call will fall back to localhost
# and fail (the app logs a loud console error if that happens).
VITE_API_URL=http://localhost:4000
