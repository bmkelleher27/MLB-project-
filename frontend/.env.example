# Base URL of the backend API (Express + socket.io).
# Required for production builds — without it the app falls back to
# http://localhost:4000 and API/socket calls fail for real users.
# Set this in your host's build env (e.g. Vercel Project → Settings →
# Environment Variables) to the deployed backend URL, then rebuild.
VITE_API_URL=https://your-backend.onrender.com
